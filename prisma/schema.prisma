// This is the Prisma schema for TRANSACTIONAL data only.
// Content (treks, blog posts, pages) is managed by Payload CMS in the same database.
// Bookings, users, payments, and seat availability live here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Users (for auth & customer accounts) ----
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  nationality   String?
  passportNumber String?
  role          String    @default("customer") // "customer" | "admin"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  bookings  Booking[]

  @@map("users")
}

// ---- NextAuth models ----
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---- Bookings ----
model Booking {
  id            String   @id @default(cuid())
  userId        String
  trekSlug      String   // References Payload CMS trek by slug
  trekTitle     String   // Denormalized for easy display
  trekPrice     Float
  trekDuration  Int
  startDate     DateTime
  groupSize     Int
  totalPrice    Float
  status        BookingStatus @default(PENDING_REVIEW)
  travelerDetails TravelerDetail[]
  specialRequests String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  payment Payment?

  @@map("bookings")
}

enum BookingStatus {
  PENDING_REVIEW
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED

  @@map("booking_status")
}

model TravelerDetail {
  id          String @id @default(cuid())
  bookingId   String
  fullName    String
  email       String
  phone       String
  nationality String
  passportNumber String?
  age         Int?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("traveler_details")
}

// ---- Payments ----
model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  amount        Float
  currency      String        @default("USD")
  method        String        // "stripe" | "esewa" | "khalti"
  status        PaymentStatus @default(PENDING)
  stripePaymentIntentId String?
  esewaTransactionId     String?
  khaltiTransactionId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED

  @@map("payment_status")
}

// ---- Seat Availability ----
model TrekAvailability {
  id        String   @id @default(cuid())
  trekSlug  String
  startDate DateTime
  seatsTotal Int
  seatsBooked Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trekSlug, startDate])
  @@map("trek_availability")
}
